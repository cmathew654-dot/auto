{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holdings Entry Assistant",
  "version": "0.1.3",
  "identifier": "com.cmathew654.holdings-emoney-assistant",
  "build": {
    "beforeBuildCommand": "npm run build:demo",
    "beforeDevCommand": "npm run build:demo",
    "frontendDist": "../demo-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Holdings Entry Assistant",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "Holdings CSV review and guided browser entry",
    "longDescription": "Holdings CSV review and operator-controlled browser entry. No project server and no automatic Save action.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
